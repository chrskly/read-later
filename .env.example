# Required: shared secret used by the iOS Shortcut / bookmarklet. Generate with: openssl rand -hex 24
READ_LATER_TOKEN=change-me

# PDF layout (CSS values). Defaults match the Sony DPT-RP1 screen (13.3", 3:4, ~203x270mm) at 1:1 scale.
PAGE_WIDTH=203mm
PAGE_HEIGHT=270mm
PAGE_MARGIN=16mm
FONT_SIZE=13pt
FONT_FAMILY=DejaVu Serif, Liberation Serif, serif
